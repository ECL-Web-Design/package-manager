{
  "name": "@ecl-design/auto-typer",
  "version": "1.3.4",
  "description": "Component that types out a list of words sequentially with animation.",
  "main": "dist/index.umd.cjs",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "set PACKAGE_NAME=auto-typer&& vite build --config ../../../../vite.config.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "ECL Web Design",
  "license": "GNU",
  "sideEffects": [
    "./dist/index.css"
  ],
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "devDependencies": {
    "vite-plugin-libcss": "^1.1.1",
    "@types/vue": "^2.0.0",
    "typescript": "^5.2.2",
    "vite": "^4.4.10",
    "vue-tsc": "^1.8.15"
  }
}
